#!/usr/bin/env bash
# Configure Nginx to add a custom X-Served-By HTTP response header matching the server's hostname

# Update package lists and install Nginx
apt-get update -y
apt-get install -y nginx

# Retrieve the current hostname
# shellcheck disable=SC2154
HOSTNAME=$(hostname)

# Define the Nginx configuration adjustment to add the custom header
# We insert it right after 'server {' or 'sendfile on;' in the default site configuration
CONFIG_LINE="\tadd_header X-Served-By $HOSTNAME;"

# Check if the header is already added to prevent duplicate entries
if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    sed -i "/sendfile on;/a \\$CONFIG_LINE" /etc/nginx/sites-available/default
fi

# Test Nginx configuration and restart service
nginx -t
service nginx restart