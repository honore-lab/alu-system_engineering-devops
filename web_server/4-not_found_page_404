#!/usr/bin/env bash
# Configures Nginx with a custom 404 error page containing "Ceci n'est pas une page"

apt-get update -y
apt-get install nginx -y

# Create the custom 404 page content
echo "Ceci n'est pas une page" > /var/www/html/custom_404.html

# Configure Nginx default site to handle 404 errors with the custom page
sed -i "/server_name _;/a \    error_page 404 /custom_404.html;\n    location = /custom_404.html {\n        internal;\n    }" /etc/nginx/sites-available/default

# Restart Nginx using init service
service nginx restart
